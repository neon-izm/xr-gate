diff --git a/src/xrt/compositor/main/comp_window_macos.m b/src/xrt/compositor/main/comp_window_macos.m
new file mode 100644
index 000000000..5ddacde68
--- /dev/null
+++ b/src/xrt/compositor/main/comp_window_macos.m
@@ -0,0 +1,345 @@
+// Copyright 2026, xr-gate contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  macOS window code, an NSWindow backed by a CAMetalLayer.
+ * @ingroup comp_main
+ */
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include "util/u_debug.h"
+#include "util/u_misc.h"
+#include "xrt/xrt_compiler.h"
+#include "main/comp_window.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+
+/*
+ *
+ * Private structs.
+ *
+ */
+
+/*!
+ * A macOS window.
+ *
+ * @implements comp_target_swapchain
+ */
+struct comp_window_macos
+{
+	struct comp_target_swapchain base;
+
+	NSWindow *window;
+	CAMetalLayer *layer;
+};
+
+// Index into [NSScreen screens], or a case-insensitive substring of localizedName.
+DEBUG_GET_ONCE_OPTION(macos_screen, "XRT_COMPOSITOR_MACOS_SCREEN", NULL)
+
+
+/*
+ *
+ * Functions.
+ *
+ */
+
+static inline struct vk_bundle *
+get_vk(struct comp_window_macos *cwm)
+{
+	return &cwm->base.base.c->base.vk;
+}
+
+static void
+run_on_main_thread(void (^block)(void))
+{
+	if ([NSThread isMainThread]) {
+		block();
+	} else {
+		dispatch_sync(dispatch_get_main_queue(), block);
+	}
+}
+
+static NSScreen *
+find_screen(struct comp_compositor *c)
+{
+	const char *wanted = debug_get_option_macos_screen();
+	if (wanted == NULL || wanted[0] == '\0') {
+		return nil;
+	}
+
+	NSArray<NSScreen *> *screens = [NSScreen screens];
+
+	char *end = NULL;
+	long index = strtol(wanted, &end, 10);
+	if (end != wanted && *end == '\0') {
+		if (index >= 0 && (NSUInteger)index < screens.count) {
+			return screens[(NSUInteger)index];
+		}
+		COMP_ERROR(c, "XRT_COMPOSITOR_MACOS_SCREEN=%s out of range, %u screens", wanted,
+		           (unsigned)screens.count);
+		return nil;
+	}
+
+	NSString *needle = [NSString stringWithUTF8String:wanted];
+	for (NSScreen *screen in screens) {
+		if ([screen.localizedName rangeOfString:needle options:NSCaseInsensitiveSearch].location != NSNotFound) {
+			return screen;
+		}
+	}
+
+	COMP_ERROR(c, "No screen matching XRT_COMPOSITOR_MACOS_SCREEN=%s", wanted);
+	return nil;
+}
+
+static void
+log_screens(struct comp_compositor *c)
+{
+	NSArray<NSScreen *> *screens = [NSScreen screens];
+	for (NSUInteger i = 0; i < screens.count; i++) {
+		NSScreen *screen = screens[i];
+		NSRect frame = screen.frame;
+		COMP_INFO(c, "Screen %u: '%s' %.0fx%.0f at %.0f,%.0f scale %.1f", (unsigned)i,
+		          screen.localizedName.UTF8String, frame.size.width, frame.size.height, frame.origin.x,
+		          frame.origin.y, screen.backingScaleFactor);
+	}
+}
+
+// OpenXR apps usually don't run an AppKit event loop, without one the window is never displayed.
+static void
+pump_events(double seconds)
+{
+	NSDate *until = [NSDate dateWithTimeIntervalSinceNow:seconds];
+	for (;;) {
+		NSEvent *event = [NSApp nextEventMatchingMask:NSEventMaskAny
+		                                    untilDate:until
+		                                       inMode:NSDefaultRunLoopMode
+		                                      dequeue:YES];
+		if (event == nil) {
+			break;
+		}
+		[NSApp sendEvent:event];
+	}
+}
+
+static bool
+create_window(struct comp_window_macos *cwm)
+{
+	struct comp_target *ct = &cwm->base.base;
+	struct comp_compositor *c = ct->c;
+
+	[NSApplication sharedApplication];
+	[NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+	[NSApp finishLaunching];
+
+	log_screens(c);
+
+	NSScreen *screen = find_screen(c);
+	NSRect frame;
+	NSWindowStyleMask style;
+	CGFloat scale;
+	if (screen != nil) {
+		frame = screen.frame;
+		style = NSWindowStyleMaskBorderless;
+		scale = screen.backingScaleFactor;
+		COMP_INFO(c, "Covering screen '%s'", screen.localizedName.UTF8String);
+	} else {
+		frame = NSMakeRect(100, 100, ct->width, ct->height);
+		style = NSWindowStyleMaskTitled | NSWindowStyleMaskMiniaturizable;
+		scale = 1.0;
+	}
+
+	cwm->window = [[NSWindow alloc] initWithContentRect:frame
+	                                          styleMask:style
+	                                            backing:NSBackingStoreBuffered
+	                                              defer:NO
+	                                             screen:screen];
+	if (cwm->window == nil) {
+		COMP_ERROR(c, "Failed to create NSWindow");
+		return false;
+	}
+	[cwm->window setReleasedWhenClosed:NO];
+	if (screen != nil) {
+		[cwm->window setFrame:frame display:NO];
+		[cwm->window setLevel:NSMainMenuWindowLevel + 1];
+		[cwm->window setHidesOnDeactivate:NO];
+	}
+
+	cwm->layer = [[CAMetalLayer alloc] init];
+	cwm->layer.contentsScale = scale;
+	cwm->layer.drawableSize = CGSizeMake(frame.size.width * scale, frame.size.height * scale);
+	cwm->layer.opaque = YES;
+
+	// Setting the layer before wantsLayer makes this a layer-hosting view, AppKit leaves its contents alone.
+	NSView *view = cwm->window.contentView;
+	view.layer = cwm->layer;
+	view.wantsLayer = YES;
+
+	ct->width = (uint32_t)(frame.size.width * scale);
+	ct->height = (uint32_t)(frame.size.height * scale);
+
+	[cwm->window makeKeyAndOrderFront:nil];
+	[NSApp activateIgnoringOtherApps:YES];
+	[CATransaction flush];
+	pump_events(0.25);
+
+	COMP_INFO(c, "Window %ux%u pixels", ct->width, ct->height);
+
+	return true;
+}
+
+static void
+comp_window_macos_destroy(struct comp_target *ct)
+{
+	struct comp_window_macos *cwm = (struct comp_window_macos *)ct;
+
+	comp_target_swapchain_cleanup(&cwm->base);
+
+	NSWindow *window = cwm->window;
+	CAMetalLayer *layer = cwm->layer;
+	cwm->window = nil;
+	cwm->layer = nil;
+	if (window != nil || layer != nil) {
+		run_on_main_thread(^{
+		  [window orderOut:nil];
+		  [window release];
+		  [layer release];
+		});
+	}
+
+	free(ct);
+}
+
+static void
+comp_window_macos_update_window_title(struct comp_target *ct, const char *title)
+{
+	struct comp_window_macos *cwm = (struct comp_window_macos *)ct;
+	if (cwm->window == nil || title == NULL) {
+		return;
+	}
+
+	NSString *str = [NSString stringWithUTF8String:title];
+	NSWindow *window = cwm->window;
+	dispatch_async(dispatch_get_main_queue(), ^{
+	  [window setTitle:str];
+	});
+}
+
+static bool
+comp_window_macos_init(struct comp_target *ct)
+{
+	struct comp_window_macos *cwm = (struct comp_window_macos *)ct;
+
+	ct->width = 1920;
+	ct->height = 1080;
+
+	__block bool ok = false;
+	run_on_main_thread(^{
+	  @autoreleasepool {
+		  ok = create_window(cwm);
+	  }
+	});
+
+	return ok;
+}
+
+static bool
+comp_window_macos_init_swapchain(struct comp_target *ct, uint32_t width, uint32_t height)
+{
+	struct comp_window_macos *cwm = (struct comp_window_macos *)ct;
+	struct vk_bundle *vk = get_vk(cwm);
+
+	VkMetalSurfaceCreateInfoEXT surface_info = {
+	    .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+	    .pLayer = cwm->layer,
+	};
+
+	VkSurfaceKHR surface = VK_NULL_HANDLE;
+	VkResult ret = vk->vkCreateMetalSurfaceEXT(vk->instance, &surface_info, NULL, &surface);
+	if (ret != VK_SUCCESS) {
+		COMP_ERROR(ct->c, "vkCreateMetalSurfaceEXT: %s", vk_result_string(ret));
+		return false;
+	}
+
+	VK_NAME_SURFACE(vk, surface, "comp_window_macos surface");
+	cwm->base.surface.handle = surface;
+
+	return true;
+}
+
+static void
+comp_window_macos_flush(struct comp_target *ct)
+{
+	(void)ct;
+}
+
+struct comp_target *
+comp_window_macos_create(struct comp_compositor *c)
+{
+	struct comp_window_macos *w = U_TYPED_CALLOC(struct comp_window_macos);
+
+	comp_target_swapchain_init_and_set_fnptrs(&w->base, COMP_TARGET_FORCE_FAKE_DISPLAY_TIMING);
+
+	w->base.base.name = "macOS";
+	w->base.display = VK_NULL_HANDLE;
+	w->base.base.destroy = comp_window_macos_destroy;
+	w->base.base.flush = comp_window_macos_flush;
+	w->base.base.init_pre_vulkan = comp_window_macos_init;
+	w->base.base.init_post_vulkan = comp_window_macos_init_swapchain;
+	w->base.base.set_title = comp_window_macos_update_window_title;
+	w->base.base.c = c;
+
+	return &w->base.base;
+}
+
+
+/*
+ *
+ * Factory
+ *
+ */
+
+static const char *instance_extensions[] = {
+    VK_KHR_SURFACE_EXTENSION_NAME,
+    VK_EXT_METAL_SURFACE_EXTENSION_NAME,
+};
+
+static bool
+detect(const struct comp_target_factory *ctf, struct comp_compositor *c)
+{
+	return false;
+}
+
+static bool
+create_target(const struct comp_target_factory *ctf, struct comp_compositor *c, struct comp_target **out_ct)
+{
+	struct comp_target *ct = comp_window_macos_create(c);
+	if (ct == NULL) {
+		return false;
+	}
+
+	*out_ct = ct;
+
+	return true;
+}
+
+/*
+ * Not deferred: AppKit windows must be created on the main thread, and creating the
+ * system compositor happens on the application thread, deferred creation does not.
+ */
+const struct comp_target_factory comp_target_factory_macos = {
+    .name = "macOS window",
+    .identifier = "macos",
+    .requires_vulkan_for_create = false,
+    .is_deferred = false,
+    .required_instance_version = 0,
+    .required_instance_extensions = instance_extensions,
+    .required_instance_extension_count = ARRAY_SIZE(instance_extensions),
+    .optional_device_extensions = NULL,
+    .optional_device_extension_count = 0,
+    .detect = detect,
+    .create_target = create_target,
+};
