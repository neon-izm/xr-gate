# SPDX-License-Identifier: MIT
# Nreal Light on macOS. capture_service_cpp needs root there, so start it
# separately with CAPTURE_ONLY=1 devices/nreal_light/scripts/macos/start.sh
# and record with START_CAPTURE_SERVICE=0.

CALIB_TARGET_NAME="nreal_light"
CALIB_LABEL="Nreal Light (OV580 stereo, device clock)"
CALIB_DEVICE_NAME="nreal_light"
CALIB_UNIT_ID="${CALIB_UNIT_ID:-unit0}"
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-stereo_640x480_device_time}"
BASALT_VIO_CONFIG_NAME="${BASALT_VIO_CONFIG_NAME:-basalt_vio_config_640x480.json}"
BASALT_VO_CONFIG_NAME="${BASALT_VO_CONFIG_NAME:-basalt_vo_config_640x480.json}"
BASALT_VIO_CONFIG_TEMPLATE="${BASALT_VIO_CONFIG_TEMPLATE:-$ROOT_PROJECT/devices/nreal_light/configs/basalt/basalt_vio_config_640x480.json}"

EXPECT_WIDTH=640
EXPECT_HEIGHT=480
RECORD_PREFIX="nreal_light_640x480_calib"

CAPTURE_CONFIG="${CAPTURE_CONFIG:-$ROOT_PROJECT/devices/nreal_light/configs/capture_service/nreal_light_macos_device_time_shm.yaml}"
CAPTURE_CONFIG_CAMERA_ONLY="$CAPTURE_CONFIG"
CAPTURE_CONFIG_STEREO_IMU="$CAPTURE_CONFIG"
START_CAPTURE_SERVICE="${START_CAPTURE_SERVICE:-0}"
# The device-to-host clock fit needs a few anchor windows before motion.
WARMUP_SECONDS="${WARMUP_SECONDS:-5.0}"

# The factory model is radtan with k3 = 0, which Kalibr pinhole-radtan matches.
CAMERA_MODEL_0="${CAMERA_MODEL_0:-pinhole-radtan}"
CAMERA_MODEL_1="${CAMERA_MODEL_1:-pinhole-radtan}"

# Screen AprilGrid from calibration/nreal_light/make_screen_aprilgrid.py
# --cols 5 --rows 3 --bit-px 40. The cameras see about 100 degrees, so smaller
# tags are too few pixels wide at 15 to 25 cm.
APRILGRID_NAME="${APRILGRID_NAME:-aprilgrid_screen_5x3_400px.yaml}"
APRILGRID_TAG_COLS=5
APRILGRID_TAG_ROWS=3
APRILGRID_TAG_SIZE_M=0.040
APRILGRID_TAG_SPACING=0.3

IMU_YAML_NAME="imu_nreal_light.yaml"
IMU_UPDATE_RATE=1000.0
# Factory imu_noises of the tested unit: [gyro_noise, gyro_bias, accel_noise, accel_bias].
# Replace with an Allan-variance measurement of the glasses at rest.
IMU_ACCEL_NOISE_DENSITY="${IMU_ACCEL_NOISE_DENSITY:-0.014}"
IMU_ACCEL_RANDOM_WALK="${IMU_ACCEL_RANDOM_WALK:-0.001}"
IMU_GYRO_NOISE_DENSITY="${IMU_GYRO_NOISE_DENSITY:-0.0004}"
IMU_GYRO_RANDOM_WALK="${IMU_GYRO_RANDOM_WALK:-0.0001}"
IMU_PROFILE_NOTE="Factory imu_noises of the Nreal Light; replace with Allan variance"

DEFAULT_RECORD_MODE="stereo_imu"
